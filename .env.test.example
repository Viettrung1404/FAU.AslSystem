# Copy to backend/.env.test; use a dedicated Neon test branch/database.
# Use a direct host (no -pooler). Tests apply real Flyway migrations.
TEST_DB_URL=jdbc:postgresql://YOUR_TEST_DIRECT_HOST.neon.tech:5432/neondb?sslmode=require&channelBinding=require&connectTimeout=30
TEST_DB_USERNAME=YOUR_TEST_ROLE
TEST_DB_PASSWORD=YOUR_TEST_PASSWORD
