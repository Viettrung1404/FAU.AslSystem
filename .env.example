# Copy to backend/.env; Spring loads this as Java properties from the working directory.
# No quotes, no export prefix. Replace placeholders with your Neon dev connection.
# Use a direct host (no -pooler) for this simple development setup.
DB_URL=jdbc:postgresql://YOUR_DIRECT_HOST.neon.tech:5432/neondb?sslmode=require&channelBinding=require&connectTimeout=30
DB_USERNAME=YOUR_NEON_ROLE
DB_PASSWORD=YOUR_NEON_PASSWORD
# Optional: if DB_URL uses a pooled host, set this to the SAME database's direct URL.
# DB_MIGRATION_URL=jdbc:postgresql://YOUR_DIRECT_HOST.neon.tech:5432/neondb?sslmode=require&channelBinding=require&connectTimeout=30
DB_POOL_SIZE=5
PORT=8080
